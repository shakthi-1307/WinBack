# ==========================================================================
# Winback — configuration
#
#   cp .env.example .env      then fill in the values you have
#
# Everything below is OPTIONAL. With no .env at all, Winback runs fully
# offline against a deterministic scripted model and a fake gateway — the
# harness, the sensitivity sweep, the attack suite and all 58 tests pass
# with no credentials. That is the CI mode, and it is not a degraded one.
#
# .env is gitignored. Never commit real keys. Check what is picked up with:
#
#   python -m core.config
# ==========================================================================


# --- Model -----------------------------------------------------------------
# Any OpenAI-compatible endpoint. Groq is the default and has a free tier.
# Get a key at https://console.groq.com/keys

WINBACK_API_KEY=
WINBACK_BASE_URL=https://api.groq.com/openai/v1
WINBACK_MODEL=llama-3.1-8b-instant

# For OpenAI instead:
#   WINBACK_BASE_URL=https://api.openai.com/v1
#   WINBACK_MODEL=gpt-4o-mini


# --- Razorpay --------------------------------------------------------------
# TEST MODE KEYS ONLY. These start with rzp_test_ — never put a live key
# (rzp_live_) in this file. Winback creates orders; a live key would create
# real ones.
#
# Dashboard -> Account & Settings -> API Keys, with the mode switch on Test.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
